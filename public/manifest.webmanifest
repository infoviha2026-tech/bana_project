{
  "name": "BANA Connect",
  "short_name": "BANA",
  "description": "Portal for students, donors, and the team of BANA Development Foundation",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#f6f5f0",
  "theme_color": "#1F4D2B",
  "lang": "en-IN",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Upload a certificate", "url": "/certificates?upload=1", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Donate", "url": "/donate", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
