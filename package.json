{
  "name": "bana-connect",
  "version": "1.0.0",
  "private": true,
  "description": "Internal portal for BANA Development Foundation — students, donors, and administrators",
  "type": "module",
  "scripts": {
    "dev": "node --watch-path=server server/index.js",
    "build": "vite build",
    "start": "node server/index.js --prod",
    "seed": "node server/seed.js",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
