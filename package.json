    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.15.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "vite": "^6.4.4"
  }
}
